{
  "name": "pagina_web_ajustech",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/free-ports.js",
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm run server\" \"npm run client\"",
    "client": "vite --host 127.0.0.1 --port 5199 --strictPort --force --open",
    "server": "node server/index.js",
    "build": "vite build",
    "start": "node --env-file=.env server/index.js",
    "start:prod": "node --env-file=.env server/index.js",
    "contacts": "node --env-file=.env scripts/read-contacts.js",
    "preview": "vite preview",
    "free": "node scripts/free-ports.js"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sass": "^1.104.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "vite": "^7.1.5"
  }
}
