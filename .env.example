# =============================================================================
# Copia a .env en el servidor. NUNCA subas .env al git / Cloudflare Pages / chat.
# Generar clave: openssl rand -hex 32
# =============================================================================

NODE_ENV=production
HOST=127.0.0.1
PORT=8799

# URL pública HTTPS (con barra final opcional)
WEB_URL=https://tu-dominio.com/

# Solo orígenes HTTPS de tu dominio (sin path, sin barra final)
CORS_ORIGINS=https://tu-dominio.com,https://www.tu-dominio.com

# AES-256-GCM para mensajes de contacto (>= 16 chars; usa 64 hex)
CONTACT_ENCRYPTION_KEY=

# Retención del JSON cifrado en server/data/contacts.json
CONTACT_TTL_DAYS=90
CONTACT_MAX_STORE=500

# Límite por IP: >10 solicitudes /api o mensajes → bloqueo 1h
IP_MAX_REQUESTS=10
IP_WINDOW_MS=900000
IP_BLOCK_MS=3600000
CONTACT_MAX_PER_WINDOW=10
CONTACT_WINDOW_MS=900000
CONTACT_COOLDOWN_MS=20000

# Anti-abuso / DDoS ligero (capa Node; Cloudflare+Nginx hacen el borde)
DDOS_MAX_PER_IP=120
DDOS_WINDOW_MS=60000
DDOS_BLOCK_MS=900000
DDOS_MAX_INFLIGHT_IP=20
DDOS_MAX_INFLIGHT=200

# Hops de proxy: Cloudflare (1) + Nginx (1) => 2 en Full SSL detrás de CF
TRUST_PROXY_HOPS=2
